# ============================================================
#  نمونه‌ی پیکربندی سیستم نوبت‌دهی
#  کپی کنید به: .env
# ============================================================

# حالت اشکال‌زدایی (0 یا 1)
APP_DEBUG=0

# درایور دیتابیس: mysql | sqlite | auto
# auto: اگر DB_HOST تنظیم شده باشد mysql وگرنه sqlite
DB_DRIVER=mysql

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nobatgiri
DB_USER=root
DB_PASS=

# --- SQLite (حالت نمایشی/توسعه) ---
# SQLITE_PATH=/absolute/path/to/storage/app.sqlite
